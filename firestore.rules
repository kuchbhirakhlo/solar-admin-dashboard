rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============ HELPER FUNCTIONS ============

    function isAuthenticated() {
      return request.auth != null;
    }

    // Safe role check: returns the role if the user document exists, otherwise null
    function roleInCollection(collection) {
      return get(/databases/$(database)/documents/$(collection)/$(request.auth.uid)).data.role;
    }

    // Check if authenticated user's email matches known admin emails
    function isEmailAdmin() {
      return request.auth.token.email == 'admin@solar.in'
        || request.auth.token.email == 'SolarXpert@gmail.com'
        || request.auth.token.email == 'admin@solar.com';
    }

    // Admin check: looks in users collection, admins collection, or falls back to email
    function isAdmin() {
      return isAuthenticated()
        && (roleInCollection('users') == 'admin'
            || roleInCollection('admins') == 'admin'
            || isEmailAdmin());
    }

    // Engineer check: authenticated user with role 'engineer' in users collection
    function isEngineer() {
      return isAuthenticated() && roleInCollection('users') == 'engineer';
    }

    // Registrar check: authenticated user with role 'registrar' in users collection
    function isRegistrar() {
      return isAuthenticated() && roleInCollection('users') == 'registrar';
    }

    // Check if engineer is the owner of a document (used for installations, service requests)
    function isEngineerOwner() {
      return isEngineer() && resource.data.engineerId == request.auth.uid;
    }

    // Check if an incoming request is from an engineer claiming ownership
    function isEngineerClaimingOwnership() {
      return isEngineer() && request.resource.data.engineerId == request.auth.uid;
    }

    // ============ COLLECTION RULES ============

    // --- Users ---
    // Read is open for unauthenticated users (required for phone-based login lookup).
    // Only contains employee profiles (name, email, phone, role, status) — non-sensitive directory data.
    // Write operations remain protected.
    match /users/{userId} {
      allow read: if true;
      allow create: if isAdmin() || request.auth.uid == userId;
      allow update: if isAdmin() || request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    // --- Admins ---
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if request.auth.uid == adminId;
    }

    // --- Customers ---
    // Admins: full access. Registrars: read/create/update (for registration & management).
    // Engineers: read only (for customer lookup). Customers: can read/update their own.
    match /customers/{customerId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || isRegistrar() || isAuthenticated();
      allow update: if isAdmin() || isRegistrar() || request.auth.uid == customerId;
      allow delete: if isAdmin();
    }

    // --- Service Requests ---
    // Admins: full access. Registrars: read/create/update (manage requests).
    // Engineers: read all, update their own assigned requests (start work, complete, cancel).
    match /serviceRequests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || isRegistrar() || isAuthenticated();
      allow update: if isAdmin() || isRegistrar()
                      || (isEngineer() && resource.data.assignedEngineerId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // --- Subscriptions ---
    // Admins: full access. Registrars: read (view active subscriptions). Engineers: read.
    match /subscriptions/{subscriptionId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || isRegistrar();
      allow update: if isAdmin() || isRegistrar();
      allow delete: if isAdmin();
    }

    // --- Subscription Plans ---
    // Admins: full access. Registrars: read (view available plans). Engineers: read.
    match /subscriptionPlans/{planId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // --- Notifications ---
    // Admins: full access. Engineers/registrars: read.
    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // --- Reports ---
    // Admins: full access. Engineers/registrars: read.
    match /reports/{reportId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // --- Partner ---
    // Admins: full access. Engineers/registrars: read.
    match /Partner/{agentId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // --- Engineers ---
    // Admins: full access. Engineers: read their own record. Registrars: read.
    match /engineers/{engineerId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin() || (isEngineer() && request.auth.uid == engineerId);
      allow delete: if isAdmin();
    }

    // --- Installations ---
    // Admins: full access. Engineers: create, read/update their own installations.
    // Registrars: read (view installation status).
    match /installations/{installationId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || isEngineer();
      allow update: if isAdmin()
                      || (isEngineer() && resource.data.engineerId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // --- Payments ---
    // Admins: full access. Registrars: read/create (record payments from registration).
    // Engineers: read.
    match /payments/{paymentId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || isRegistrar();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // --- Default: deny everything else ---
    match /{document=**} {
      allow read, write: if false;
    }
  }
}