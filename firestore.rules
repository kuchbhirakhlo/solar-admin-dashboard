rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    // True when the document's ID matches the caller's Firebase Auth UID
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Reads caller's user doc to get their role.
    // ONLY call this when the user is already authenticated and their doc exists.
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Agent check — reads users/{uid}.role
    function isAgent() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && getUserData().get('role', '') == 'agent';
    }

    // ── users ─────────────────────────────────────────────────────────────────
    //
    // Flow 1 — Customer self-registration:
    //   After OTP, Firebase Auth UID is known. Customer creates users/{their_uid}.
    //   Rule: isOwner(userId) covers this — auth.uid == doc.id.
    //
    // Flow 2 — Agent login lookup:
    //   verifyOtp queries users WHERE phone == callerPhone AND role == 'agent'.
    //   Firestore evaluates rules per-document. We allow read if the document's
    //   phone matches the caller's verified phone token — no extra Firestore read.
    //
    // Flow 3 — Agent writes customer's users doc:
    //   Agent creates users/{customerId} for a new customer. isAgent() covers this.
    //
    match /users/{userId} {
      // Any signed-in user can read a doc where phone == their own phone number
      // (needed for agent login lookup by phone, and for customer self-lookup).
      // Own doc read is always allowed. Agents can read any user doc.
      allow read: if isOwner(userId)
        || (isSignedIn() && resource.data.phone == request.auth.token.phone_number)
        || isAgent();

      // Customer creates their own doc on first OTP login.
      // Agent creates customer user docs.
      allow create: if (isOwner(userId) || isAgent())
        && request.resource.data.get('role', '') == 'customer';

      // Preserve profile editing without allowing changes to access-control fields.
      allow update: if (isOwner(userId) || isAgent())
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['role', 'status', 'customerId', 'uid']);

      allow delete: if false;
    }

    // ── customers ─────────────────────────────────────────────────────────────
    //
    // This is the CRM table — created and managed by agents.
    // Customers can read their own record (matched by UID or phone).
    // Agents have full read/write access.
    //
    match /customers/{customerId} {
      allow read: if isOwner(customerId)
        // Allow customer to find their record by phone (for login linking)
        || (isSignedIn() && resource.data.phone == request.auth.token.phone_number)
        // Allow agent who owns this customer record to read it
        || (isSignedIn() && resource.data.assignedAgentId == request.auth.uid)
        || isAgent();

      allow create: if isAgent();
      allow update: if isAgent();
      allow delete: if false;
    }

    // ── dashboard ─────────────────────────────────────────────────────────────
    //
    // One doc per customer (doc ID == customer Firebase Auth UID).
    // Customer reads their own. Agents read all and write.
    // Customer can CREATE their own dashboard doc on first login (auto-init),
    // but only agents can UPDATE it (they push live solar production data).
    //
    match /dashboard/{customerId} {
      allow read: if isOwner(customerId) || isAgent();
      allow create: if isOwner(customerId) || isAgent();
      allow update: if isAgent();
      allow delete: if false;
    }

    // ── serviceRequests ───────────────────────────────────────────────────────
    //
    // Customers create and read their own requests.
    // Agents manage all requests.
    // Uses direct field comparison (assignedAgentId) to avoid extra Firestore
    // reads for agent's own assigned requests.
    //
    match /serviceRequests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.customerId == request.auth.uid
        || resource.data.assignedAgentId == request.auth.uid
        || isAgent()
      );
      allow create: if isSignedIn()
        && request.resource.data.customerId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.customerId == request.auth.uid
        || resource.data.assignedAgentId == request.auth.uid
        || isAgent()
      );
      allow delete: if false;
    }

    // ── subscriptions ─────────────────────────────────────────────────────────
    match /subscriptions/{subscriptionId} {
      allow read: if isSignedIn() && (
        resource.data.customerId == request.auth.uid || isAgent()
      );
      allow create: if isAgent();
      allow update: if isAgent();
      allow delete: if false;
    }

    // ── reports ───────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      allow read: if isSignedIn() && (
        resource.data.customerId == request.auth.uid || isAgent()
      );
      allow create: if isAgent();
      allow update: if isAgent();
      allow delete: if false;
    }

    // ── notifications ─────────────────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAgent()
      );
      allow create: if isSignedIn();
      // Users can only mark their own notifications as read
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }

    // Web dashboard permissions supplement the app rules above.
    // Matching allow rules are additive; deletes are granted only to admins.
    function signedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == role
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'active') == 'active';
    }

    // Legacy staff profiles may have an unset status.
    function hasStaffRole(collectionName, role) {
      return signedIn()
        && exists(/databases/$(database)/documents/$(collectionName)/$(request.auth.uid))
        && get(/databases/$(database)/documents/$(collectionName)/$(request.auth.uid)).data.get('role', '') == role
        && get(/databases/$(database)/documents/$(collectionName)/$(request.auth.uid)).data.get('status', null) in [null, '', 'active'];
    }

    // Support both admin profile locations used by the original rules.
    function isAdmin() {
      return hasStaffRole('users', 'admin')
        || hasStaffRole('admins', 'admin');
    }

    function isRegistrar() {
      return hasStaffRole('users', 'registrar');
    }

    function managesCustomers() {
      return isAdmin() || isRegistrar();
    }

    function ownsCustomer(customerId) {
      return hasRole('customer') && customerId is string && customerId != ''
        && (customerId == request.auth.uid
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('customerId', '') == customerId
          || (exists(/databases/$(database)/documents/customers/$(customerId))
            && get(/databases/$(database)/documents/customers/$(customerId)).data.get('customerUid', '') == request.auth.uid));
    }

    // Engineers are created with auto IDs and a separate Firebase Auth uid field.
    function ownsEngineer(engineerId) {
      return hasRole('engineer') && engineerId is string && engineerId != ''
        && (engineerId == request.auth.uid
          || (exists(/databases/$(database)/documents/engineers/$(engineerId))
            && get(/databases/$(database)/documents/engineers/$(engineerId)).data.get('uid', '') == request.auth.uid));
    }

    function ownsRequest(data) {
      return hasRole('customer')
        && (data.get('customerUid', '') == request.auth.uid
          || ownsCustomer(data.get('customerId', '')));
    }

    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // The client rewrites the notes array; require exactly one appended note.
    function appendsNote(role) {
      let before = resource.data.get('notes', []);
      let after = request.resource.data.get('notes', []);
      let note = after[before.size()];
      return before is list && after is list
        && after.size() == before.size() + 1
        && after == before.concat([note])
        && note.keys().hasOnly(['id', 'text', 'addedBy', 'addedByRole', 'timestamp'])
        && note.id is string && note.text is string && note.text.size() > 0
        && note.addedBy is string && note.timestamp is string
        && note.addedByRole == role;
    }

    match /users/{userId} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == userId)
        || (isRegistrar() && resource.data.role == 'customer');
      // Registrar queries must include where('role', '==', 'customer').
      allow list: if isAdmin() || (isRegistrar() && resource.data.role == 'customer');
      // Registrars create customer profiles via addCustomer(), with auto IDs.
      allow create: if isAdmin()
        || (isRegistrar()
          && request.resource.data.keys().hasOnly([
            'name', 'email', 'phone', 'address', 'city', 'state', 'zipCode',
            'role', 'status', 'customerId', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.role == 'customer'
          && request.resource.data.status == 'active'
          && request.resource.data.customerId is string
          && exists(/databases/$(database)/documents/customers/$(request.resource.data.customerId)));
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == userId
          && changedOnly(['name', 'phone', 'address', 'city', 'state', 'zipCode', 'lastLogin', 'updatedAt']));
      allow delete: if isAdmin();
    }

    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    match /customers/{customerId} {
      // Engineers search customers by phone when recording an installation.
      allow read: if managesCustomers() || hasRole('engineer')
        || (hasRole('customer')
          && (resource.data.get('customerUid', '') == request.auth.uid || ownsCustomer(customerId)));
      allow create: if managesCustomers();
      allow update: if isAdmin()
        || (isRegistrar() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['customerUid', 'uid']));
      allow delete: if isAdmin();
    }

    match /serviceRequests/{requestId} {
      allow read: if managesCustomers()
        || ownsEngineer(resource.data.get('assignedEngineerId', ''))
        || ownsRequest(resource.data);
      allow create: if managesCustomers()
        || (ownsCustomer(request.resource.data.customerId)
          && request.resource.data.keys().hasOnly([
            'customerId', 'customerName', 'customerPhone', 'customerUid',
            'type', 'status', 'priority', 'date', 'assignedEngineer',
            'assignedEngineerId', 'description', 'createdBy', 'notes', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.customerUid == request.auth.uid
          && request.resource.data.createdBy == 'customer'
          && request.resource.data.status == 'pending'
          && request.resource.data.type in ['Maintenance', 'Repair', 'Inspection']
          && request.resource.data.priority == 'medium'
          && request.resource.data.assignedEngineer == ''
          && request.resource.data.assignedEngineerId == ''
          && request.resource.data.description is string
          && request.resource.data.description.size() > 0
          && request.resource.data.notes == []);
      allow update: if managesCustomers()
        || (ownsEngineer(resource.data.get('assignedEngineerId', ''))
          && changedOnly(['status', 'notes', 'updatedAt'])
          && request.resource.data.status in ['pending', 'in-progress', 'completed', 'cancelled']
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['notes'])
            || appendsNote('engineer')))
        || (ownsRequest(resource.data)
          && changedOnly(['notes', 'updatedAt']) && appendsNote('customer'));
      allow delete: if isAdmin();
    }

    match /engineers/{engineerId} {
      allow read: if managesCustomers() || ownsEngineer(engineerId)
        || (hasRole('engineer') && resource.data.get('uid', '') == request.auth.uid);
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (ownsEngineer(engineerId) && changedOnly(['name', 'phone', 'updatedAt']));
    }

    match /installations/{installationId} {
      allow read: if managesCustomers()
        || ownsEngineer(resource.data.get('engineerId', ''))
        || ownsCustomer(resource.data.get('customerId', ''));
      allow create: if isAdmin()
        || (hasRole('engineer') && request.resource.data.engineerId == request.auth.uid);
      allow update: if isAdmin()
        || (ownsEngineer(resource.data.get('engineerId', ''))
          && changedOnly([
            'inverterSerialNumber', 'solarPanelSerialNumbers', 'acWireUsed',
            'dcWireUsed', 'earthingWireUsed', 'notes', 'installationDate', 'updatedAt'
          ]));
      allow delete: if isAdmin();
    }

    match /subscriptions/{subscriptionId} {
      allow read: if managesCustomers() || ownsCustomer(resource.data.get('customerId', ''));
      allow create, update: if managesCustomers();
      allow delete: if isAdmin();
    }

    match /subscriptionPlans/{planId} {
      allow read: if managesCustomers() || hasRole('customer');
      allow write: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if managesCustomers() || ownsCustomer(resource.data.get('customerId', ''));
      allow create: if managesCustomers();
      allow update, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.get('userId', '') == request.auth.uid)
        || ownsEngineer(resource.data.get('userId', ''));
      allow create: if managesCustomers();
      allow update: if isAdmin()
        || (signedIn()
          && (resource.data.get('userId', '') == request.auth.uid
            || ownsEngineer(resource.data.get('userId', '')))
          && changedOnly(['read', 'updatedAt'])
          && request.resource.data.read is bool);
      allow delete: if isAdmin();
    }

    match /Partner/{partnerId} {
      allow read: if isAdmin()
        || ((hasRole('partner') || hasRole('agent'))
          && (partnerId == request.auth.uid || resource.data.get('uid', '') == request.auth.uid));
      allow write: if isAdmin();
    }

    match /reports/{reportId} {
      allow read, write: if isAdmin();
    }

    // App solar dashboards also support admin management.
    match /dashboard/{customerId} {
      allow read, create, update, delete: if isAdmin();
    }

    // ── deny everything else ──────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
