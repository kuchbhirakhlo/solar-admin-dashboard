rules_version = '2';

// Firestore rules only; Cloud Storage requires a separate ruleset.
// Provision users/{authUid} and the first admin through a trusted Admin SDK
// or Firebase Console. Roles and customerId links must never be self-assigned.
// Before deploying:
// - Replace pre-auth phone lookups with Firebase Auth or a trusted login service.
// - Create employee Auth accounts without replacing the signed-in admin session.
// - Link customer Auth UIDs to users/{authUid}.customerId (customer records use auto IDs).
// - Engineer request queries must use the same ID stored in assignedEngineerId:
//   the admin UI currently stores engineers document IDs, while the portal queries UIDs.
// Browser sessionStorage values are not authentication credentials.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == role
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'active') == 'active';
    }

    // Legacy staff profiles may have an unset status.
    function hasStaffRole(collectionName, role) {
      return signedIn()
        && exists(/databases/$(database)/documents/$(collectionName)/$(request.auth.uid))
        && get(/databases/$(database)/documents/$(collectionName)/$(request.auth.uid)).data.get('role', '') == role
        && get(/databases/$(database)/documents/$(collectionName)/$(request.auth.uid)).data.get('status', null) in [null, '', 'active'];
    }

    // Support both admin profile locations used by the original rules.
    function isAdmin() {
      return hasStaffRole('users', 'admin')
        || hasStaffRole('admins', 'admin');
    }

    function isRegistrar() {
      return hasStaffRole('users', 'registrar');
    }

    function managesCustomers() {
      return isAdmin() || isRegistrar();
    }

    function ownsCustomer(customerId) {
      return hasRole('customer') && customerId is string && customerId != ''
        && (customerId == request.auth.uid
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('customerId', '') == customerId
          || (exists(/databases/$(database)/documents/customers/$(customerId))
            && get(/databases/$(database)/documents/customers/$(customerId)).data.get('customerUid', '') == request.auth.uid));
    }

    // Engineers are created with auto IDs and a separate Firebase Auth uid field.
    function ownsEngineer(engineerId) {
      return hasRole('engineer') && engineerId is string && engineerId != ''
        && (engineerId == request.auth.uid
          || (exists(/databases/$(database)/documents/engineers/$(engineerId))
            && get(/databases/$(database)/documents/engineers/$(engineerId)).data.get('uid', '') == request.auth.uid));
    }

    function ownsRequest(data) {
      return hasRole('customer')
        && (data.get('customerUid', '') == request.auth.uid
          || ownsCustomer(data.get('customerId', '')));
    }

    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // The client rewrites the notes array; require exactly one appended note.
    function appendsNote(role) {
      let before = resource.data.get('notes', []);
      let after = request.resource.data.get('notes', []);
      let note = after[before.size()];
      return before is list && after is list
        && after.size() == before.size() + 1
        && after == before.concat([note])
        && note.keys().hasOnly(['id', 'text', 'addedBy', 'addedByRole', 'timestamp'])
        && note.id is string && note.text is string && note.text.size() > 0
        && note.addedBy is string && note.timestamp is string
        && note.addedByRole == role;
    }

    match /users/{userId} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == userId)
        || (isRegistrar() && resource.data.role == 'customer');
      // Registrar queries must include where('role', '==', 'customer').
      allow list: if isAdmin() || (isRegistrar() && resource.data.role == 'customer');
      // Registrars create customer profiles via addCustomer(), with auto IDs.
      allow create: if isAdmin()
        || (isRegistrar()
          && request.resource.data.keys().hasOnly([
            'name', 'email', 'phone', 'address', 'city', 'state', 'zipCode',
            'role', 'status', 'customerId', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.role == 'customer'
          && request.resource.data.status == 'active'
          && request.resource.data.customerId is string
          && exists(/databases/$(database)/documents/customers/$(request.resource.data.customerId)));
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == userId
          && changedOnly(['name', 'phone', 'address', 'city', 'state', 'zipCode', 'lastLogin', 'updatedAt']));
      allow delete: if isAdmin();
    }

    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    match /customers/{customerId} {
      // Engineers search customers by phone when recording an installation.
      allow read: if managesCustomers() || hasRole('engineer')
        || (hasRole('customer')
          && (resource.data.get('customerUid', '') == request.auth.uid || ownsCustomer(customerId)));
      allow create: if managesCustomers();
      allow update: if isAdmin()
        || (isRegistrar() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['customerUid', 'uid']));
      allow delete: if isAdmin();
    }

    match /serviceRequests/{requestId} {
      allow read: if managesCustomers()
        || ownsEngineer(resource.data.get('assignedEngineerId', ''))
        || ownsRequest(resource.data);
      allow create: if managesCustomers()
        || (ownsCustomer(request.resource.data.customerId)
          && request.resource.data.keys().hasOnly([
            'customerId', 'customerName', 'customerPhone', 'customerUid',
            'type', 'status', 'priority', 'date', 'assignedEngineer',
            'assignedEngineerId', 'description', 'createdBy', 'notes', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.customerUid == request.auth.uid
          && request.resource.data.createdBy == 'customer'
          && request.resource.data.status == 'pending'
          && request.resource.data.type in ['Maintenance', 'Repair', 'Inspection']
          && request.resource.data.priority == 'medium'
          && request.resource.data.assignedEngineer == ''
          && request.resource.data.assignedEngineerId == ''
          && request.resource.data.description is string
          && request.resource.data.description.size() > 0
          && request.resource.data.notes == []);
      allow update: if managesCustomers()
        || (ownsEngineer(resource.data.get('assignedEngineerId', ''))
          && changedOnly(['status', 'notes', 'updatedAt'])
          && request.resource.data.status in ['pending', 'in-progress', 'completed', 'cancelled']
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['notes'])
            || appendsNote('engineer')))
        || (ownsRequest(resource.data)
          && changedOnly(['notes', 'updatedAt']) && appendsNote('customer'));
      allow delete: if isAdmin();
    }

    match /engineers/{engineerId} {
      allow read: if managesCustomers() || ownsEngineer(engineerId)
        || (hasRole('engineer') && resource.data.get('uid', '') == request.auth.uid);
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (ownsEngineer(engineerId) && changedOnly(['name', 'phone', 'updatedAt']));
    }

    match /installations/{installationId} {
      allow read: if managesCustomers()
        || ownsEngineer(resource.data.get('engineerId', ''))
        || ownsCustomer(resource.data.get('customerId', ''));
      allow create: if isAdmin()
        || (hasRole('engineer') && request.resource.data.engineerId == request.auth.uid);
      allow update: if isAdmin()
        || (ownsEngineer(resource.data.get('engineerId', ''))
          && changedOnly([
            'inverterSerialNumber', 'solarPanelSerialNumbers', 'acWireUsed',
            'dcWireUsed', 'earthingWireUsed', 'notes', 'installationDate', 'updatedAt'
          ]));
      allow delete: if isAdmin();
    }

    match /subscriptions/{subscriptionId} {
      allow read: if managesCustomers() || ownsCustomer(resource.data.get('customerId', ''));
      allow create, update: if managesCustomers();
      allow delete: if isAdmin();
    }

    match /subscriptionPlans/{planId} {
      allow read: if managesCustomers() || hasRole('customer');
      allow write: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if managesCustomers() || ownsCustomer(resource.data.get('customerId', ''));
      allow create: if managesCustomers();
      allow update, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.get('userId', '') == request.auth.uid)
        || ownsEngineer(resource.data.get('userId', ''));
      allow create: if managesCustomers();
      allow update: if isAdmin()
        || (signedIn()
          && (resource.data.get('userId', '') == request.auth.uid
            || ownsEngineer(resource.data.get('userId', '')))
          && changedOnly(['read', 'updatedAt'])
          && request.resource.data.read is bool);
      allow delete: if isAdmin();
    }

    match /Partner/{partnerId} {
      allow read: if isAdmin()
        || ((hasRole('partner') || hasRole('agent'))
          && (partnerId == request.auth.uid || resource.data.get('uid', '') == request.auth.uid));
      allow write: if isAdmin();
    }

    match /reports/{reportId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
